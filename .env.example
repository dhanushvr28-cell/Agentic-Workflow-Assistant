# Any OpenAI-compatible provider with tool calling.
# Groq   : https://api.groq.com/openai/v1                           key: https://console.groq.com/keys
# Gemini : https://generativelanguage.googleapis.com/v1beta/openai/  key: https://aistudio.google.com/app/apikey
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_key_here
LLM_MODEL=openai/gpt-oss-20b

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DB_PATH=data/shop.db
MAX_STEPS=8
# The demo data is generated relative to this date so results are reproducible.
REFERENCE_DATE=2026-11-01
